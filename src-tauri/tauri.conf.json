{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inq Studio",
  "version": "1.3.1",
  "identifier": "com.voltiq.inq-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inq Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0D0E11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Voltiq",
    "copyright": "© 2026 Voltiq",
    "category": "Productivity",
    "shortDescription": "A professional PDF viewer and editor",
    "longDescription": "Inq Studio views, edits and organises PDF documents. Edit text in the fonts the document already uses, mark up and redact, fill in forms, sign and check signatures, protect with passwords, make scans searchable, compare documents, optimise file size and convert to PDF/A.",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "German"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NTY3OERCQjVFOTgyQUQKUldTdGd1bTEyM2hXMTJYYTNqR2YrNFQyUlRxc3BhZlpaN1owa0ZZbU5lcjczOHExQStiV1lscXUK",
      "endpoints": [
        "https://github.com/Voltiq/Inq-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
